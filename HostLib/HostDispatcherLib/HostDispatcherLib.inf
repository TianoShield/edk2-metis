## @file HostDispatcherLib.inf
#  DXE-Dispatcher-style driver initialization for host fuzzing.
#
#  This library provides a mini-dispatcher that emulates the UEFI DXE Core's
#  driver connection mechanism.  Harnesses declare a driver registry and call
#  HostDispatchDrivers() instead of manually calling EntryPoint/Supported/Start.
#
#  Copyright (c) 2025-2026 TianoShield Contributors.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = HostDispatcherLib
  FILE_GUID                      = A1B2C3D4-E5F6-4789-ABCD-123456789ABC
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = HostDispatcherLib

[Sources]
  HostDispatcherLib.c

[Packages]
  MdePkg/MdePkg.dec
  Edk2Fuzz/Edk2Fuzz.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  UefiBootServicesTableLib
