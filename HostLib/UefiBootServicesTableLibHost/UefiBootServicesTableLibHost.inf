## @file
#  UefiBootServicesTableLibHost - Host UEFI Boot Services implementation.
#
#  ## AUDIT — Host Fuzzing Environment ##
#  Provides gBS, gST, gImageHandle, gFuzzHandle for host-based fuzzing.
#  All 44 Boot Services are wired in mBootServices:
#  - Memory: AllocatePages/FreePages/AllocatePool/FreePool/GetMemoryMap (via libc)
#  - Protocol: Install/Uninstall/Handle/Open/Close/Locate/Register/Reinstall
#  - Event/Timer: CreateEvent/CreateEventEx/SetTimer/Signal/Wait/Close/Check
#  - TPL: RaiseTPL/RestoreTPL
#  - Misc: Stall, SetWatchdogTimer, GetNextMonotonicCount, CalculateCrc32,
#          InstallConfigurationTable, ExitBootServices, CopyMem, SetMem
#  - Driver: ConnectController/DisconnectController
#  - Stubs: LoadImage/StartImage/Exit/UnloadImage (ASSERT on call)
#
# Copyright (c) 2018, Intel Corporation. All rights reserved.<BR>
# Copyright (c) 2024, HBFAplus Contributors. All rights reserved.<BR>
# SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UefiBootServicesTableLibHost
  FILE_GUID                      = D440EF07-2EFD-4054-BEAC-88ED18722C8F
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = UefiBootServicesTableLib
  CONSTRUCTOR                    = UefiBootServicesTableLibConstructor

[Sources]
  UefiBootServicesTableLibHost.c
  EventDxeCore.c
  TimerDxeCore.c
  TplDxeCore.c
  HostShim.c
  MockTimerHost.c
  MockDeferredSignal.c
  DriverSupport.c
  Handle.c
  Locate.c
  Notify.c
  Library.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  NetworkPkg/NetworkPkg.dec
  Edk2Fuzz/Edk2Fuzz.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DevicePathLib
  FuzzContextLib
  PerformanceLib

[Guids]
  gEfiEventExitBootServicesGuid
  gEfiEventVirtualAddressChangeGuid
  gIdleLoopEventGuid

[Protocols]
  gEfiDevicePathProtocolGuid
  gEfiDpcProtocolGuid
  gEfiPlatformDriverOverrideProtocolGuid
  gEfiDriverBindingProtocolGuid
  gEfiBusSpecificDriverOverrideProtocolGuid
  gEfiDriverFamilyOverrideProtocolGuid
  gEfiLoadedImageProtocolGuid
